<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application android:networkSecurityConfig="@xml/network_security_config">
        <!-- Throwaway spike UI, debug builds only: adb shell am start -n com.muratkirazkaya.meiro/.spike.SpikeActivity (extra: action) -->
        <activity
            android:name=".spike.SpikeActivity"
            android:exported="true"
            android:label="Meiro Spike"
            android:launchMode="singleTop" />
        <service
            android:name=".spike.PlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback" />
        <!-- adb entry for the real playback service, see DebugPlayActivity.kt -->
        <activity
            android:name=".debug.DebugPlayActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
    </application>
</manifest>
