#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")/.."

GO_VERSION="1.27.3"
GO_ROOT="$HOME/.local/share/go/$GO_VERSION"
GO_ARCHIVE_DIR="$HOME/.cache/amp/downloads"
GO_ARCHIVE="$GO_ARCHIVE_DIR/go${GO_VERSION}.linux-$(uname -m).tar.gz"
# Bazelisk reads the repository's .bazelversion, so this is the only Bazel
# version the repository needs to agree on.
BAZELISK_VERSION="1.30.0"
BAZELISK_ROOT="$HOME/.local/share/bazelisk/$BAZELISK_VERSION"
BAZELISK_ARCHIVE_DIR="$GO_ARCHIVE_DIR"

log() {
	printf '[meiro setup] %s %s\n' "$(date --iso-8601=seconds)" "$*"
}

log "Checking GTK 3 runtime"
if ! dpkg-query -W -f='${Status}' libgtk-3-0 2>/dev/null | grep -q 'install ok installed'; then
	if [[ "$(id -u)" -eq 0 ]]; then
		APT=(apt-get)
	elif command -v sudo >/dev/null 2>&1; then
		APT=(sudo -n apt-get)
	else
		printf 'GTK 3 is missing and neither root nor sudo is available.\n' >&2
		exit 1
	fi
	"${APT[@]}" update
	"${APT[@]}" install -y libgtk-3-0
fi

case "$(uname -m)" in
	x86_64)
		GO_SHA256="65efbc80fdc1fa2cd2631cad5b481777a68e8725f34e89f50fc6ac714e379b40"
		GO_PLATFORM="amd64"
		BAZELISK_PLATFORM="amd64"
		BAZELISK_SHA256="a248ae2b2b62b5baebb748f6fba7203bff1a27e5d01b55399a8406744cb539e8"
		;;
	aarch64 | arm64)
		GO_SHA256="a06e99309dbcbdca1a8ccd2282c3ee146e55930886e26b4f1193269587165f49"
		GO_PLATFORM="arm64"
		BAZELISK_PLATFORM="arm64"
		BAZELISK_SHA256="b2bcc040c213b44586b121bda6d983c35df121b917c3a7a66fb16f2fa0df1a4f"
		;;
	*)
		printf 'Unsupported Go architecture: %s\n' "$(uname -m)" >&2
		exit 1
		;;
esac

mkdir -p "$HOME/.local/share/go" "$HOME/.local/bin" "$GO_ARCHIVE_DIR"
if [[ ! -x "$GO_ROOT/bin/go" ]] || [[ "$("$GO_ROOT/bin/go" version 2>/dev/null || true)" != "go version go${GO_VERSION} linux/${GO_PLATFORM}" ]]; then
	GO_ARCHIVE="$GO_ARCHIVE_DIR/go${GO_VERSION}.linux-${GO_PLATFORM}.tar.gz"
	log "Installing Go ${GO_VERSION}"
	if [[ ! -f "$GO_ARCHIVE" ]] || [[ "$(sha256sum "$GO_ARCHIVE" | cut -d ' ' -f 1)" != "$GO_SHA256" ]]; then
		curl -fsSL "https://go.dev/dl/go${GO_VERSION}.linux-${GO_PLATFORM}.tar.gz" -o "$GO_ARCHIVE"
	fi
	echo "$GO_SHA256  $GO_ARCHIVE" | sha256sum --check --status || {
		rm -f "$GO_ARCHIVE"
		printf 'Go archive checksum verification failed.\n' >&2
		exit 1
	}
	TMP_DIR="$(mktemp -d)"
	trap 'rm -rf "$TMP_DIR"' EXIT
	tar -xzf "$GO_ARCHIVE" -C "$TMP_DIR"
	rm -rf "$GO_ROOT"
	mv "$TMP_DIR/go" "$GO_ROOT"
fi

ln -sfn "$GO_ROOT/bin/go" "$HOME/.local/bin/go"
ln -sfn "$GO_ROOT/bin/gofmt" "$HOME/.local/bin/gofmt"

# A single release binary, so there is no archive to unpack.
bazelisk="$BAZELISK_ROOT/bazelisk"
if [[ ! -x "$bazelisk" ]] || [[ "$("$bazelisk" version 2>/dev/null | head -n 1 || true)" != "Bazelisk version: v${BAZELISK_VERSION}" ]]; then
	BAZELISK_ARCHIVE="$BAZELISK_ARCHIVE_DIR/bazelisk-linux-${BAZELISK_PLATFORM}"
	log "Installing bazelisk ${BAZELISK_VERSION}"
	if [[ ! -f "$BAZELISK_ARCHIVE" ]] || [[ "$(sha256sum "$BAZELISK_ARCHIVE" | cut -d ' ' -f 1)" != "$BAZELISK_SHA256" ]]; then
		curl -fsSL "https://github.com/bazelbuild/bazelisk/releases/download/v${BAZELISK_VERSION}/bazelisk-linux-${BAZELISK_PLATFORM}" -o "$BAZELISK_ARCHIVE"
	fi
	echo "$BAZELISK_SHA256  $BAZELISK_ARCHIVE" | sha256sum --check --status || {
		rm -f "$BAZELISK_ARCHIVE"
		printf 'bazelisk checksum verification failed.\n' >&2
		exit 1
	}
	mkdir -p "$BAZELISK_ROOT"
	install -m 0755 "$BAZELISK_ARCHIVE" "$bazelisk"
fi
ln -sfn "$bazelisk" "$HOME/.local/bin/bazelisk"
ln -sfn "$bazelisk" "$HOME/.local/bin/bazel"

PROFILE="$HOME/.bash_profile"
PROFILE_MARKER='# meiro Go and Bazel toolchains'
if ! grep -Fqx "$PROFILE_MARKER" "$PROFILE" 2>/dev/null && ! grep -Fqx '# meiro Go toolchain' "$PROFILE" 2>/dev/null; then
	cat >> "$PROFILE" <<'EOF'

# meiro Go and Bazel toolchains
case ":$PATH:" in
	*:"$HOME/.local/bin":*) ;;
	*) export PATH="$HOME/.local/bin:$PATH" ;;
esac
EOF
fi
export PATH="$HOME/.local/bin:$PATH"
log "Go toolchain ready: $(go version)"
log "Bazel toolchain ready: bazelisk ${BAZELISK_VERSION} for Bazel $(cat .bazelversion)"

# Running the real app on the orb Desktop and driving it (see
# .agents/skills/verify-meiro). The orb already has ffmpeg, Node.js and Bun.
# The app needs yt-dlp, a screenshot tool (grim), a keyboard injector (wtype)
# and a pointer injector (wlrctl, which no Debian 12 package ships).
YTDLP_VERSION="2026.08.19"
WLRCTL_COMMIT="c6bc60820bb8786c7509e651bcae9393a738f180"

apt_install() {
	if [[ "$(id -u)" -eq 0 ]]; then
		apt-get update && apt-get install -y "$@"
	elif command -v sudo >/dev/null 2>&1; then
		sudo -n apt-get update && sudo -n apt-get install -y "$@"
	else
		printf 'Missing packages (%s) and neither root nor sudo is available.\n' "$*" >&2
		exit 1
	fi
}

missing=()
for pkg in grim wtype; do
	dpkg-query -W -f='${Status}' "$pkg" 2>/dev/null | grep -q 'install ok installed' || missing+=("$pkg")
done
if [[ ${#missing[@]} -gt 0 ]]; then
	log "Installing ${missing[*]}"
	apt_install "${missing[@]}"
fi

case "$(uname -m)" in
	x86_64) YTDLP_ASSET="yt-dlp_linux" YTDLP_SHA256="58162f9bfdc27458ea47bfcb311cf47028f17d8154a8bf7d689861d46399230a" ;;
	aarch64 | arm64) YTDLP_ASSET="yt-dlp_linux_aarch64" YTDLP_SHA256="b16e4dab368a816cd05d477d698a605a6ae87ccee1c8ffd38fa21d7254141fcc" ;;
esac
if [[ "$("$HOME/.local/bin/yt-dlp" --version 2>/dev/null || true)" != "$YTDLP_VERSION" ]]; then
	log "Installing yt-dlp ${YTDLP_VERSION}"
	tmp_ytdlp="$(mktemp)"
	curl -fsSL "https://github.com/yt-dlp/yt-dlp/releases/download/${YTDLP_VERSION}/${YTDLP_ASSET}" -o "$tmp_ytdlp"
	echo "$YTDLP_SHA256  $tmp_ytdlp" | sha256sum --check --status || {
		rm -f "$tmp_ytdlp"
		printf 'yt-dlp checksum verification failed.\n' >&2
		exit 1
	}
	install -m 0755 "$tmp_ytdlp" "$HOME/.local/bin/yt-dlp"
	rm -f "$tmp_ytdlp"
fi

if [[ ! -x "$HOME/.local/bin/wlrctl" ]] || [[ ! -f "$HOME/.local/share/wlrctl-$WLRCTL_COMMIT" ]]; then
	log "Building wlrctl ${WLRCTL_COMMIT:0:7}"
	build_missing=()
	for pkg in meson ninja-build libwayland-dev libxkbcommon-dev wayland-protocols pkg-config gcc; do
		dpkg-query -W -f='${Status}' "$pkg" 2>/dev/null | grep -q 'install ok installed' || build_missing+=("$pkg")
	done
	if [[ ${#build_missing[@]} -gt 0 ]]; then
		apt_install "${build_missing[@]}"
	fi
	wlrctl_src="$(mktemp -d)"
	git clone -q https://git.sr.ht/~brocellous/wlrctl "$wlrctl_src"
	git -C "$wlrctl_src" checkout -q "$WLRCTL_COMMIT"
	meson setup "$wlrctl_src/build" "$wlrctl_src" >/dev/null
	ninja -C "$wlrctl_src/build" >/dev/null
	install -m 0755 "$wlrctl_src/build/wlrctl" "$HOME/.local/bin/wlrctl"
	touch "$HOME/.local/share/wlrctl-$WLRCTL_COMMIT"
	rm -rf "$wlrctl_src"
fi
log "Desktop tools ready: grim, wtype, wlrctl, yt-dlp ${YTDLP_VERSION}"
